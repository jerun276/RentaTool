# ==============================================================================
# RentaTool LK - Production Environment Configuration Template
# Copy this file to .env.production on your AWS EC2 instance:
#   cp .env.production.example .env.production
# ==============================================================================

# Database Credentials
POSTGRES_DB=rentatool_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_secure_production_password_here

# JWT Authentication
JWT_SECRET=RentaToolLK_Production_Secret_Jwt_SecurityKey_2026_Minimum32Chars!
JWT_ISSUER=https://rentatool.lk
JWT_AUDIENCE=https://rentatool.lk

# AI Subsystem (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash
