# ==============================================================================
# RentaTool LK – Master Environment Configuration Template (.env.example)
# Copy this file to .env and replace the placeholder values with your credentials.
# Note: .env is ignored by Git and will NEVER be committed.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Database Configuration
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=rentatool_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ASP.NET Core EF Core Connection String Format:
ConnectionStrings__DefaultConnection="Host=localhost;Port=5432;Database=rentatool_db;Username=postgres;Password=your_postgres_password_here"

# ------------------------------------------------------------------------------
# 2. JWT Authentication & Security (Component 1 & Universal Shared)
# ------------------------------------------------------------------------------
JWT_SECRET="RentaToolLK_SuperSecret_Jwt_SecurityKey_SE3090_2026_Minimum32Chars!"
JWT_ISSUER="https://rentatool.lk"
JWT_AUDIENCE="https://rentatool.lk"
JWT_EXPIRY_MINUTES=120

# ------------------------------------------------------------------------------
# 3. AI Subsystem Credentials (LangGraph & Domain Analysis Agent - Component 2)
# ------------------------------------------------------------------------------
GEMINI_API_KEY="your_google_gemini_api_key_here"
GEMINI_MODEL="gemini-2.0-flash"

# ------------------------------------------------------------------------------
# 4. Web & Client Gateway Settings
# ------------------------------------------------------------------------------
VITE_API_BASE_URL="http://localhost:5000/api/v1"
PORT=3000
